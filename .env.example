# Supabase project settings. Keep real values in .env.local or Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for Admin to create Auth users. Never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=

# Business date calculations use this timezone.
BUSINESS_TIMEZONE=Asia/Kuala_Lumpur
